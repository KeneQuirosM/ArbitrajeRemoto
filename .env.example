# Local development only (npm run dev:api). Never commit the real .env.
# ADMIN_PASSPHRASE_HASH: output of `npm run hash-passphrase`. Keep the single quotes: the value contains '$'.
ADMIN_PASSPHRASE_HASH='scrypt$32768$8$1$REPLACE$REPLACE'
# SESSION_SECRET: output of `npm run gen-secret` (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-value
